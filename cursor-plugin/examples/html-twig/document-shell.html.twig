{# HTML in Twig — Document shell examples (base layouts only) #}
{# Each block: RULE, WHY, WHY NOT, DON'T DO, PREFER #}

{# =============================================================================
   RULE: Start with <!DOCTYPE html>; lang on <html>; shell only in base layouts
   WHY: Standards mode; locale for a11y/SEO; partials must not duplicate document.
   WHY NOT: Missing DOCTYPE triggers quirks mode; nested <html> from includes breaks DOM.
   ============================================================================= #}

{# --- DON'T DO (in _card.html.twig partial) --- #}
{# <html><head><title>Card</title></head><body>...</body></html> #}

{# --- PREFER (base.html.twig only) --- #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|slice(0, 2) }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% trans %}app.title{% endtrans %}{% endblock %}</title>
    {% block stylesheets %}{% endblock %}
  </head>
  <body>
    <main>
      {% block body %}{% endblock %}
    </main>
    {% block javascripts %}{% endblock %}
  </body>
</html>

{# =============================================================================
   RULE: One <main> per page; no <base>; no explicit favicon link
   WHY: Landmark uniqueness; <base> hijacks relative URLs; browsers fetch /favicon.ico.
   WHY NOT: Two <main> confuse screen readers; <base href="/old/"> breaks asset paths.
   ============================================================================= #}

{# --- DON'T DO --- #}
{# <base href="/v1/"> #}
{# <link rel="icon" href="/favicon.ico"> #}
{# include partial that also wraps content in <main> #}

{# --- PREFER --- #}
{# Single <main> in layout; relative links like href="/contact" #}

{# =============================================================================
   RULE: Omit type on style/script; https:// external URLs; styles before scripts in head
   WHY: HTML5 defaults; mixed content blocked; CSS before JS avoids FOUC flash.
   WHY NOT: type="text/javascript" is redundant; //cdn.example.com blocked on HTTPS pages.
   ============================================================================= #}

{# --- DON'T DO --- #}
{# <script type="text/javascript" src="//cdn.example.com/lib.js"></script> #}

{# --- PREFER --- #}
{# <link rel="stylesheet" href="{{ asset('styles/app.css') }}"> #}
{# <script src="https://cdn.example.com/lib.js" defer></script> #}
